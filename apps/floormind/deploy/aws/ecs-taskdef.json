{
  "family": "floormind",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/floormind-task-role",
  "containerDefinitions": [
    {
      "name": "floormind-app",
      "image": "DOCKERHUB_USERNAME/floormind:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8501,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "FLOORMIND_DB", "value": "mssql+pyodbc://DB_USER:DB_PASS@DB_HOST/DB_NAME?driver=ODBC+Driver+17+for+SQL+Server"},
        {"name": "OLLAMA_BASE_URL", "value": "http://OLLAMA_HOST:11434"},
        {"name": "OLLAMA_MODEL", "value": "gemma3:12b"},
        {"name": "ENVIRONMENT", "value": "production"},
        {"name": "SENTRY_DSN", "value": "SENTRY_DSN_HERE"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/floormind",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8501/_stcore/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 30
      },
      "readonlyRootFilesystem": false,
      "tmpfs": [
        {"name": "/tmp", "size": 256}
      ]
    }
  ]
}
