# Dashboard environment variables
# Copy to .env.local. All are optional; defaults point at localhost.

# schema-scout backend
NEXT_PUBLIC_SCOUT_URL=http://localhost:8080
# sql-steward MCP server
NEXT_PUBLIC_SQL_STEWARD_URL=http://localhost:8081
# elenchus backend
NEXT_PUBLIC_ELENCHUS_URL=http://localhost:8000
# agent-blackbox ledger
NEXT_PUBLIC_BLACKBOX_URL=http://localhost:8082